<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SupaMaui.MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <ListView x:Name="listproduct" Grid.ColumnSpan="2" Margin="10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <ViewCell.View>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                
                                <Label Text="{Binding Name}"/>
                                <Label Text="{Binding Category}" Grid.Row="1"/>
                                <Label Text="{Binding Cost}" Grid.Column="1"/>
                                <Label Text="{Binding Count}" Grid.Column="1" Grid.Row="1"/>
                                <Image Source="{Binding Img}" Grid.Column="2" Grid.RowSpan="2"/>
                            </Grid>
                        </ViewCell.View>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button x:Name="add" Text="OTP" Clicked="add_Clicked" Grid.Row="1" Margin="10" />
        <Button x:Name="del" Text="Delete" Clicked="del_Clicked" Grid.Row="1" Grid.Column="1" Margin="10" />
        <Entry AutomationId="email" x:Name="email" Grid.Row="2" Margin="10"/>
        <Entry AutomationId="pass" x:Name="password" Grid.Row="2" Grid.Column="1" Margin="10"/>
        <Button AutomationId="enter" x:Name="enter" Text="Enter" Grid.Row="3" Clicked="enter_Clicked" Margin="10"/>
        <Entry  x:Name="otp" Grid.Row="3" Grid.Column="1" Margin="10"/>
    </Grid>

</ContentPage>
