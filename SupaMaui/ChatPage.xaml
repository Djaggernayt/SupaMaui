<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SupaMaui.ChatPage"
             Title="ChatPage">
    <VerticalStackLayout Padding="16" Spacing="12">

        <CollectionView x:Name="MessagesView" ItemsSource="{Binding Messages}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="8" Margin="4" BorderColor="LightGray">
                        <VerticalStackLayout>
                        <Label Text="{Binding SenderId}" FontSize="16" />
                        <Label Text="{Binding Message}" FontSize="16" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid ColumnDefinitions="*,Auto">
            <Entry x:Name="enterM"  Placeholder="Введите сообщение..." />
            <Button Grid.Column="1" Text="Отправить" Clicked="Button_Clicked" />
        </Grid>

    </VerticalStackLayout>
</ContentPage>